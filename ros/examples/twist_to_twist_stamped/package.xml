<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>twist_to_twist_stamped</name>
  <version>0.1.0</version>
  <description>Republish geometry_msgs/msg/Twist as TwistStamped and repeat the last command so a chassis watchdog keeps seeing fresh setpoints.</description>
  <maintainer email="ros-tooling+foxglove_bridge@foxglove.dev">Foxglove</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
