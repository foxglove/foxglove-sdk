Based on upstream: https://github.com/warmcat/libwebsockets/commit/54e67208976494a4a2235f2e0fc959d46bcb7452
Keep mutable proxy-address parsing separate from the const authentication pointer.

diff --git a/lib/core-net/client/client.c b/lib/core-net/client/client.c
index e3bc6d5..d377733 100644
--- a/lib/core-net/client/client.c
+++ b/lib/core-net/client/client.c
@@ -31,6 +31,7 @@ lws_set_proxy(struct lws_vhost *vhost, const char *proxy)
 {
 	char authstring[96];
 	int brackets = 0;
+	const char *auth;
 	char *p;
 
 	if (!proxy)
@@ -40,15 +41,15 @@ lws_set_proxy(struct lws_vhost *vhost, const char *proxy)
 	if (!strncmp(proxy, "http://", 7))
 		proxy += 7;
 
-	p = strrchr(proxy, '@');
-	if (p) { /* auth is around */
+	auth = strrchr(proxy, '@');
+	if (auth) { /* auth is around */
 
-		if (lws_ptr_diff_size_t(p, proxy) > sizeof(authstring) - 1)
+		if (lws_ptr_diff_size_t(auth, proxy) > sizeof(authstring) - 1)
 			goto auth_too_long;
 
-		lws_strncpy(authstring, proxy, lws_ptr_diff_size_t(p, proxy) + 1);
+		lws_strncpy(authstring, proxy, lws_ptr_diff_size_t(auth, proxy) + 1);
 		// null termination not needed on input
-		if (lws_b64_encode_string(authstring, lws_ptr_diff(p, proxy),
+		if (lws_b64_encode_string(authstring, lws_ptr_diff(auth, proxy),
 				vhost->proxy_basic_auth_token,
 		    sizeof vhost->proxy_basic_auth_token) < 0)
 			goto auth_too_long;
@@ -56,7 +57,7 @@ lws_set_proxy(struct lws_vhost *vhost, const char *proxy)
 		lwsl_vhost_info(vhost, " Proxy auth in use");
 
 #if defined(LWS_ROLE_H1) || defined(LWS_ROLE_H2)
-		proxy = p + 1;
+		proxy = auth + 1;
 #endif
 	} else
 		vhost->proxy_basic_auth_token[0] = '\0';
